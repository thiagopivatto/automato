{
  "name": "ultron",
  "version": "1.1.8",
  "description": "Ultron — bot brasileiro para WhatsApp com utilidades, downloads e IA.",
  "type": "module",
  "exports": "./app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "smoke": "node scripts/smoke-apis.js",
    "test": "npm run test:unidade && npm run test:handlers && node scripts/test-smoke.js && npm run test:statusgrupo && node scripts/test-integracao.js",
    "test:smoke": "node scripts/test-smoke.js",
    "test:integracao": "node scripts/test-integracao.js",
    "test:statusgrupo": "node --experimental-test-module-mocks --test scripts/test-status-grupo.js scripts/test-status-grupo-media.js scripts/test-status-grupo-relay.js",
    "test:regressao": "node scripts/test-smoke.js",
    "test:unidade": "node scripts/run-unidade.js",
    "bench:tiers": "node scripts/bench-comandos-meta.js",
    "test:handlers": "node scripts/test-handlers-dry.js",
    "docs:comandos": "node scripts/gerar-comandos-md.js",
    "docs:lista": "node scripts/gerar-lista-comandos-txt.js",
    "docs": "node scripts/gerar-comandos-md.js && node scripts/gerar-lista-comandos-txt.js",
    "sync:vendor": "node scripts/sync-vendor.js",
    "backup": "node scripts/backup-dados.js",
    "version:bump": "node scripts/bump-version.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "prepare": "node scripts/install-git-hooks.js",
    "postinstall": "node --input-type=module -e \"import('node:path').then(async path=>{const {pathToFileURL}=await import('node:url');const root=process.env.INIT_CWD||process.cwd();await import(pathToFileURL(path.join(root,'scripts','postinstall.js')).href)})\"",
    "patch:statusgrupo": "node scripts/patch-baileys-group-status.js",
    "setup:tts": "bash scripts/setup-edge-tts.sh"
  },
  "author": "Thiago Pivatto",
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "bot",
    "sticker",
    "ultron"
  ],
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@seald-io/nedb": "^4.0.4",
    "@victorsouzaleal/lbot-api-comandos": "file:vendor/lbot-api-comandos",
    "@vitalets/google-translate-api": "^9.2.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.13.2",
    "chalk": "^4.1.2",
    "dotenv": "^16.5.0",
    "fs-extra": "^11.3.0",
    "moment-timezone": "^0.5.48",
    "node-cache": "^5.1.2",
    "p-queue": "^8.0.1",
    "pino": "^8.21.0",
    "qrcode-terminal": "^0.12.0",
    "undici": "^6.29.1"
  },
  "overrides": {
    "axios": "$axios",
    "uuid": "^11.1.1",
    "form-data": "^4.0.4",
    "qs": "^6.17.0",
    "tough-cookie": "^4.1.4",
    "file-type": "22.3.0",
    "follow-redirects": "1.16.2",
    "ip-address": "^10.7.4",
    "moment": "^2.31.0",
    "stream-json": "^3.7.0",
    "undici": "^6.29.1",
    "deepmerge": "4.1.2",
    "music-metadata": "^12.3.4",
    "fluent-ffmpeg": "npm:@modernized/fluent-ffmpeg@^1.0.3",
    "jsdom": "^27.4.0",
    "encoding-sniffer": "^1.0.2",
    "html-encoding-sniffer": "^7.0.0"
  }
}
