{
  "name": "ultron",
  "version": "1.0.0",
  "description": "Ultron — bot brasileiro para WhatsApp com utilidades, downloads e IA.",
  "type": "module",
  "exports": "./app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "smoke": "node scripts/smoke-apis.js",
    "test": "node scripts/test-smoke.js && node --test scripts/test-status-grupo.js && node scripts/test-integracao.js",
    "test:smoke": "node scripts/test-smoke.js",
    "test:integracao": "node scripts/test-integracao.js",
    "test:statusgrupo": "node --test scripts/test-status-grupo.js",
    "test:regressao": "node scripts/test-smoke.js",
    "docs:comandos": "node scripts/gerar-comandos-md.js",
    "docs:lista": "node scripts/gerar-lista-comandos-txt.js",
    "docs": "node scripts/gerar-comandos-md.js && node scripts/gerar-lista-comandos-txt.js",
    "sync:vendor": "node scripts/sync-vendor.js",
    "postinstall": "node scripts/sync-vendor.js",
    "setup:tts": "bash scripts/setup-edge-tts.sh",
    "gerar:conteudo": "node scripts/gerar-conteudo-json.js"
  },
  "author": "Thiago Pivatto",
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "bot",
    "sticker",
    "ultron"
  ],
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@seald-io/nedb": "^4.0.4",
    "@victorsouzaleal/lbot-api-comandos": "file:vendor/lbot-api-comandos",
    "@vitalets/google-translate-api": "^9.2.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.18.1",
    "chalk": "^4.1.2",
    "dotenv": "^16.5.0",
    "format-duration-time": "^1.5.4",
    "fs-extra": "^11.3.0",
    "link-preview-js": "^4.0.4",
    "moment-timezone": "^0.5.48",
    "node-cache": "^5.1.2",
    "p-queue": "^8.0.1",
    "pino": "^8.21.0",
    "qrcode-terminal": "^0.12.0"
  },
  "overrides": {
    "axios": "$axios",
    "uuid": "^11.1.1",
    "form-data": "^4.0.4",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.4",
    "file-type": "16.5.4"
  }
}
