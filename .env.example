# Copie para .env e preencha. Não commite o .env real.

# Dono do bot (seu WhatsApp) — só dígitos com DDI
DONO=5511999999999

# --- Disco local (IMPORTANTE: não use UNC/NAS no caminho quente) ---
# Clone/rode o bot no SSD. Aponte dados/sessão para pasta local:
# ULTRON_DATA_DIR=C:\ultron-data
# ULTRON_SESSAO_DIR=C:\ultron-data\sessao
# ULTRON_TEMP_DIR=C:\ultron-data\temp
# ULTRON_BACKUP_DIR=\\Pivatto_NAS\backup\ultron
# ULTRON_HEALTH_PORT=3921
# ULTRON_SKIP_VENDOR_SYNC=1
# ULTRON_UPSERT_BACKUP=0
# ULTRON_INGRESS_MAX=8

# IA texto
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Modelo :free no OpenRouter (antes do pago na cascade)
OPENROUTER_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free
RAPIDAPI_KEY=
# Perplexity2 (RapidAPI Hub) — só !pesquisa (não no hot path do chat)
PERPLEXITY_RAPIDAPI_KEY=
# Pesquisa web no chat (Tavily/Brave + DDG/Wiki)
TAVILY_API_KEY=
# TAVILY_KEYLESS=1
BRAVE_SEARCH_API_KEY=
# DeepAI — fallback de !criarimg (opcional)
# DEEPAI_API_KEY=

# Cascade chat: openrouter-free → openrouter (barato) → pollinations → gemini
# OPENROUTER_MODEL=openai/gpt-4o-mini
# IA_PROVIDERS=openrouter-free,openrouter,pollinations,gemini
IA_BUDGET_MS=8000
# IA_GEMINI_MAX_MODELS=1
# IA_DEBUG=0

# Histórico: visão/STT automáticos OFF por padrão (custo)
# HISTORICO_AUTO_VISAO=1
# HISTORICO_AUTO_STT=1

# Fila de comandos (escala ~centenas de grupos)
# FILA_CONCURRENCY=12
# FILA_CHAT_CONCURRENCY=1
# FILA_TIMEOUT_MS=180000
# MAX_CHAT_QUEUES=500

# Log (pino): info | warn | error | debug — default warn
# LOG_LEVEL=warn

# Voz / TTS — Edge grátis para todos; ElevenLabs só quando o DONO gera áudio
ELEVENLABS_API_KEY=
# Voice Library → Portuguese (Brazil) → copie o Voice ID:
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TTS_EDGE_VOICE=pt-BR-AntonioNeural

# Disco / backup
# ULTRON_BACKUP_DIR=
# ULTRON_BACKUP_KEEP=7
# LIMPEZA_LEVE_MS=10800000

# Downloads
YTDLP_PATH=
YTDLP_COOKIES=
# YTDLP_BROWSER_COOKIES=chrome   # evite no Windows com Chrome aberto; prefira cookies.txt
COBALT_API_URL=
COBALT_API_KEY=

# ACRCloud (!qualmusica)
acr_host=
acr_access_key=
acr_access_secret=

# Deepgram (!ouvir)
dg_secret_key=
